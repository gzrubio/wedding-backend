PORT=3001
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
DB_PATH=./wedding.db
API_KEY=your-secret-api-key-here

# OpenTelemetry Configuration
# Set OTEL_ENABLED=false to disable telemetry (e.g., for local development)
OTEL_ENABLED=true

# Grafana Cloud OTLP endpoint (get from Grafana Cloud → OTLP configuration)
# Format: https://otlp-gateway-{region}.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp

# Grafana Cloud authentication (get from Grafana Cloud → Access Policies)
# NOTE: Do NOT use OTEL_EXPORTER_OTLP_HEADERS — the OTel SDK auto-reads it and misparses JSON.
# Format: {"Authorization": "Basic <base64-encoded-instance-id:token>"}
OTLP_HEADERS={"Authorization":"Basic YOUR_BASE64_TOKEN_HERE"}
